<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="@dimen/top_padding"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="@dimen/page_padding">

        <TextView
            android:id="@+id/title"
            style="@style/SurveyTitle"
            android:text="@string/summary_title" />

        <TextView
            android:id="@+id/description"
            style="@style/SurveyBody"
            android:layout_marginTop="@dimen/field_gap"
            android:text="@string/summary_description" />

        <TextView
            android:id="@+id/label_name"
            style="@style/SurveyCaption"
            android:layout_marginTop="@dimen/field_gap"
            android:text="@string/name" />

        <TextView
            android:id="@+id/value_name"
            style="@style/SurveyBody"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/label_birth"
            style="@style/SurveyCaption"
            android:layout_marginTop="@dimen/field_gap"
            android:text="@string/birth" />

        <TextView
            android:id="@+id/value_birth"
            style="@style/SurveyBody"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/label_email"
            style="@style/SurveyCaption"
            android:layout_marginTop="@dimen/field_gap"
            android:text="@string/email" />

        <TextView
            android:id="@+id/value_email"
            style="@style/SurveyBody"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/label_phone"
            style="@style/SurveyCaption"
            android:layout_marginTop="@dimen/field_gap"
            android:text="@string/phone" />

        <TextView
            android:id="@+id/value_phone"
            style="@style/SurveyBody"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/label_topic"
            style="@style/SurveyCaption"
            android:layout_marginTop="@dimen/field_gap"
            android:text="@string/topic" />

        <TextView
            android:id="@+id/value_topic"
            style="@style/SurveyBody"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/label_contact"
            style="@style/SurveyCaption"
            android:layout_marginTop="@dimen/field_gap"
            android:text="@string/summary_contact" />

        <TextView
            android:id="@+id/value_contact"
            style="@style/SurveyBody"
            android:textIsSelectable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share"
            style="@style/SurveyButton"
            android:layout_marginTop="@dimen/field_gap"
            android:text="@string/share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit"
            style="@style/SurveySecondaryButton"
            android:layout_marginTop="@dimen/field_gap"
            android:text="@string/edit" />
    </LinearLayout>
</ScrollView>
